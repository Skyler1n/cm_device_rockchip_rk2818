<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="70dp">
    <ImageView android:gravity="center" android:layout_gravity="center" android:id="@+id/play_ornot_icon" android:paddingLeft="10dp" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="0.104"/>
    <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.896">
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <TextView android:textSize="22dp" android:textColor="@color/white" android:gravity="center_vertical" android:id="@+id/track_name" android:layout_width="0dp" android:layout_height="match_parent" android:singleLine="true" android:layout_weight="0.75"/>
            <TextView android:scrollbarAlwaysDrawHorizontalTrack="true" android:textSize="22sp" android:textColor="@color/white" android:gravity="center" android:id="@+id/track_duration" android:layout_width="0dp" android:layout_height="match_parent" android:singleLine="true" android:layout_weight="0.23"/>
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.02"/>
        </LinearLayout>
        <TextView android:textSize="22sp" android:textColor="@color/blue" android:gravity="center" android:id="@+id/track_artistname" android:paddingRight="5dp" android:layout_width="match_parent" android:layout_height="0dp" android:singleLine="true" android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
