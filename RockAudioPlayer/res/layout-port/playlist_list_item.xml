<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="horizontal" android:id="@+id/playlist_item" android:background="@drawable/textadapter" android:layout_width="match_parent" android:layout_height="60dp">
    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.0125"/>
    <ImageView android:id="@+id/playlist_playlistimage" android:background="@drawable/playlist_playlistimage" android:layout_width="0dp" android:layout_height="50dp" android:layout_marginTop="5dp" android:layout_weight="0.0625"/>
    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.0375"/>
    <TextView android:textSize="22dp" android:textColor="@color/orange2" android:id="@+id/playlist_playlistname" android:paddingTop="15dp" android:layout_width="0dp" android:layout_height="60dp" android:text="@string/playlist_title" android:layout_weight="0.375"/>
    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.3125"/>
    <ImageView android:layout_gravity="center" android:id="@+id/playlist_operate_delete" android:background="@drawable/playlist_delete" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="0.1"/>
    <ImageView android:layout_gravity="center" android:id="@+id/playlist_operate_add" android:background="@drawable/playlist_add" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="0.1"/>
</LinearLayout>
