<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:id="@+id/main_layout" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:id="@+id/search_layout" android:background="@drawable/searchbk" android:visibility="visible" android:layout_width="match_parent" android:layout_height="120dp">
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <Button android:id="@+id/downstatus" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/DownLoad_Page" android:layout_weight="0.24"/>
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginRight="-10dp" android:src="@drawable/explorer_filesearch_1" android:layout_weight="0.2"/>
            <EditText android:textSize="17dp" android:textColorHint="@color/deepturqoise" android:id="@+id/SearchText" android:layout_width="0dp" android:layout_height="match_parent" android:verticalSpacing="600dp" android:hint="@string/netsearch_input" android:layout_weight="0.56"/>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <Button android:id="@+id/prebutton" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/PrePage" android:layout_weight="0.23"/>
            <Button android:id="@+id/nextbutton" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/NextPage" android:layout_weight="0.23"/>
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.04"/>
            <Button android:gravity="center" android:id="@+id/SearchButton" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/search_title" android:layout_weight="0.23"/>
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.04"/>
            <Button android:id="@+id/search_return" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/searchnet_return" android:layout_weight="0.23"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <ListView android:id="@android:id/list" android:layout_width="match_parent" android:layout_height="match_parent" android:drawSelectorOnTop="false"/>
        <include android:layout_gravity="center" android:id="@+id/song_details" layout="@layout/song_details"/>
    </FrameLayout>
</LinearLayout>
