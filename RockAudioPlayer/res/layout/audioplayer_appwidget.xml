<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:background="@drawable/appwidget_bg" android:layout_width="match_parent" android:layout_height="wrap_content">
    <ImageButton android:id="@+id/control_pre" android:background="@android:color/transparent" android:layout_width="35dp" android:layout_height="match_parent" android:src="@drawable/appwidget_pre" android:scaleType="center" android:layout_alignParentLeft="true"/>
    <ImageButton android:id="@+id/control_play" android:background="@android:color/transparent" android:layout_width="48dp" android:layout_height="match_parent" android:layout_marginLeft="2dp" android:src="@drawable/appwidget_play" android:scaleType="center" android:layout_toRightOf="@+id/control_pre"/>
    <ImageButton android:id="@+id/control_next" android:background="@android:color/transparent" android:layout_width="35dp" android:layout_height="match_parent" android:src="@drawable/appwidget_next" android:scaleType="center" android:layout_alignParentRight="true"/>
    <LinearLayout android:gravity="center_vertical" android:orientation="vertical" android:id="@+id/album_appwidget" android:background="@drawable/appwidget_inner_dither" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_toLeftOf="@+id/control_next" android:layout_toRightOf="@+id/control_play">
        <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/appwidget_text" android:ellipsize="none" android:id="@+id/title" android:fadingEdge="horizontal" android:fadingEdgeLength="20dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="10dp" android:layout_marginRight="20dp" android:singleLine="true"/>
        <TextView android:textSize="14sp" android:textColor="@color/appwidget_text" android:ellipsize="none" android:id="@+id/artist" android:fadingEdge="horizontal" android:fadingEdgeLength="20dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="10dp" android:layout_marginRight="20dp" android:singleLine="true"/>
    </LinearLayout>
</RelativeLayout>
