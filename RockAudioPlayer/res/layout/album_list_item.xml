<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="100dp">
    <ImageView android:id="@+id/album_image" android:visibility="visible" android:layout_width="150dp" android:layout_height="match_parent"/>
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
        <TextView android:textSize="22dp" android:textColor="@color/white" android:gravity="center_vertical" android:id="@+id/album_name" android:paddingLeft="20dp" android:layout_width="match_parent" android:layout_height="65dp" android:layout_marginLeft="20dp" android:singleLine="true"/>
        <TextView android:textSize="15dp" android:textColor="@color/white" android:gravity="center_vertical" android:id="@+id/album_songsnum" android:paddingLeft="20dp" android:layout_width="match_parent" android:layout_height="35dp" android:layout_marginLeft="20dp" android:singleLine="true"/>
    </LinearLayout>
</LinearLayout>
